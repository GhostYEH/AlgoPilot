# 复制此文件为 .env 并填入真实配置
# JWT 配置（必填）
JWT_SECRET=请替换为长随机字符串
JWT_EXPIRE_MINUTES=10080

# 数据库配置（可选，默认为 SQLite）
# DATABASE_URL=sqlite:///./data/alp_learning.db

# 科大讯飞星火 Spark 大模型（必填，用于画像、资源生成、AI 诊断等功能）
SPARK_API_PASSWORD=你的星火_APIPassword
SPARK_MODEL=lite
# 可选：自定义 API 地址（默认使用讯飞星火 OpenAI 兼容接口）
# SPARK_CHAT_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
# 可选：单次请求最大 token 上限（默认 4096）
# SPARK_MAX_TOKENS_LIMIT=4096
# 可选：非流式请求超时秒数（默认 90）
# SPARK_TIMEOUT=90
# 可选：流式请求超时秒数（默认 180）
# SPARK_STREAM_TIMEOUT=180
