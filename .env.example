# 复制此文件为 .env 并填入真实配置
# JWT 配置（必填）
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRE_MINUTES=10080

# 数据库配置（可选，默认为 SQLite）
DATABASE_URL=sqlite:///./data/alp_learning.db

# 科大讯飞星火 Spark 大模型（默认核心模型；画像、资源生成、AI 诊断等功能需要）
SPARK_API_PASSWORD=your-spark-api-password
SPARK_MODEL=lite
# SPARK_CHAT_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# 科大讯飞在线语音合成（教学短视频 / Tutor 讲解音频试听）
IFLYTEK_TTS_APP_ID=your-iflytek-app-id
IFLYTEK_TTS_API_KEY=your-iflytek-api-key
IFLYTEK_TTS_API_SECRET=your-iflytek-api-secret
TTS_VOICE=x4_xiaoyan
