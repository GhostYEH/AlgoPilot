# 复制此文件为 .env 并填入真实配置
# JWT 配置（必填）
JWT_SECRET=请替换为长随机字符串
JWT_EXPIRE_MINUTES=10080

# 数据库配置（可选，默认为 SQLite）
# DATABASE_URL=sqlite:///./data/alp_learning.db

# 科大讯飞星火 Spark 大模型（必填，用于画像、资源生成、AI 诊断等功能）
SPARK_API_PASSWORD=你的星火_APIPassword
SPARK_MODEL=lite
# 可选：自定义 API 地址（默认使用讯飞星火 OpenAI 兼容接口）
# SPARK_CHAT_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
# 可选：单次请求最大 token 上限（默认 4096）
# SPARK_MAX_TOKENS_LIMIT=4096
# 可选：非流式请求超时秒数（默认 90）
# SPARK_TIMEOUT=90
# 可选：流式请求超时秒数（默认 180）
# SPARK_STREAM_TIMEOUT=180

# 科大讯飞在线语音合成（可选，用于教案 AI 朗读）
# 在 https://www.xfyun.cn 创建应用并开通「语音合成（流式版）」后获取三元组
IFLYTEK_TTS_APP_ID=你的讯飞_APPID
IFLYTEK_TTS_API_KEY=你的讯飞_APIKey
IFLYTEK_TTS_API_SECRET=你的讯飞_APISecret
# 发音人 vcn，可在控制台试听后填写，如 x4_xiaoyan、x4_yezi
TTS_VOICE=x4_xiaoyan
# 可选：TTS WebSocket 超时秒数（默认 30）
# TTS_TIMEOUT=30
# 可选：TTS SSL 证书验证，生产环境建议开启（默认 true）
# TTS_SSL_VERIFY=true
