# 数据库：默认使用「后端目录/data/alp_learning.db」的 SQLite，无需安装 MySQL。
# 若需改用其他 SQLite 路径或 MySQL 等，可取消注释并修改：
# DATABASE_URL=sqlite:////绝对路径/自定义.db
# DATABASE_URL=mysql+pymysql://用户:密码@127.0.0.1:3306/alp_learning?charset=utf8mb4

JWT_SECRET=请替换为长随机字符串
JWT_EXPIRE_MINUTES=10080

# 讯飞星火 Spark 大模型（必填，用于画像、资源生成、AI 诊断等功能）
SPARK_API_PASSWORD=你的星火_APIPassword
SPARK_MODEL=lite
# 可选：自定义 API 地址（默认使用讯飞星火 OpenAI 兼容接口）
# SPARK_CHAT_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# 阿里云百炼 · CosyVoice 语音合成（可选，用于文章朗读功能）
DASHSCOPE_API_KEY=你的百炼_API_Key
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
